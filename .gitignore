data/

# 评估/回归测试输出
evaluation/

# 本地工具状态
.zcode/

# 运行时生成的散件输出
detections.json
views_branch/meta.json

# 平台/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 桌面版构建产物与本地环境
build/
dist/
.venv-desktop/
.playwright-cli/
